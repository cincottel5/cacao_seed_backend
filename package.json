{
  "name": "personal-budget-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/interfaces/http/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/interfaces/http/server.js",
    "lint": "eslint .",
    "test:unit": "tsx --test tests/unit/**/*.test.ts",
    "test:contract": "tsx --test tests/contract/**/*.test.ts",
    "test": "npm run test:unit && npm run test:contract",
    "migrate": "tsx src/infrastructure/db/migrate.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "google-auth-library": "^9.10.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.5",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^10.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
